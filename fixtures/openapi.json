  "components": {
    "schemas": {
      "Citation": {
        "properties": {
          "source_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Source Id"
          },
          "doc_id": {
            "type": "string",
            "title": "Doc Id"
          },
          "revision": {
            "type": "string",
            "title": "Revision"
          },
          "section": {
            "type": "string",
            "title": "Section"
          },
          "excerpt": {
            "type": "string",
            "maxLength": 600,
            "title": "Excerpt"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "doc_id",
          "revision",
          "section",
          "excerpt",
          "url"
        ],
        "title": "Citation"
      },
      "Clarification": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Question"
          },
          "options": {
            "items": {
              "type": "string",
              "maxLength": 100
            },
            "type": "array",
            "maxItems": 4,
            "title": "Options"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question",
          "options"
        ],
        "title": "Clarification"
      },
      "Components": {
        "properties": {
          "storage": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Storage"
          },
          "embedding": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Embedding"
          },
          "generation": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Generation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "storage",
          "embedding",
          "generation"
        ],
        "title": "Components"
      },
      "Error": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error",
          "request_id"
        ],
        "title": "Error"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "Handoff": {
        "properties": {
          "issue": {
            "type": "string",
            "title": "Issue"
          },
          "confirmed_product": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "hp-a",
                  "hp-b"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Confirmed Product"
          },
          "attempted_steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Attempted Steps"
          },
          "missing_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Fields"
          },
          "reason": {
            "type": "string",
            "enum": [
              "no_evidence",
              "conflicting_policy",
              "refund_request",
              "clarification_limit"
            ],
            "title": "Reason"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Source Ids"
          },
          "user_statements": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "User Statements"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "issue",
          "confirmed_product",
          "attempted_steps",
          "missing_fields",
          "reason",
          "source_ids",
          "user_statements"
        ],
        "title": "Handoff"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
