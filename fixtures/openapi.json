        "type": "object",
        "title": "SessionInput"
      },
      "Source": {
        "properties": {
          "source_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Source Id"
          },
          "release_id": {
            "type": "string",
            "title": "Release Id"
          },
          "doc_id": {
            "type": "string",
            "title": "Doc Id"
          },
          "revision": {
            "type": "string",
            "title": "Revision"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "section": {
            "type": "string",
            "title": "Section"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "superseded",
              "withdrawn"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "release_id",
          "doc_id",
          "revision",
          "title",
          "section",
          "text",
          "status"
        ],
        "title": "Source"
      },
      "Turn": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "answer",
              "clarify",
              "handoff",
              "unavailable"
            ],
            "title": "Status"
          },
          "answer": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "clarification": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Clarification"
              },
              {
                "type": "null"
              }
            ]
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "handoff_summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Handoff"
              },
              {
                "type": "null"
              }
            ]
          },
          "release_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Release Id"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "answer",
          "clarification",
          "citations",
          "handoff_summary",
          "release_id",
          "request_id"
        ],
        "title": "Turn"
      },
      "TurnInput": {
        "properties": {
          "client_turn_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Client Turn Id"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "product_id": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "hp-a",
                  "hp-b"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_turn_id",
          "message"
        ],
        "title": "TurnInput"
      }
    }
