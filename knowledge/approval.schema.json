{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewer",
    "manifest_sha256",
    "document_hashes",
    "approved_at",
    "corpus_sha256"
  ],
  "properties": {
    "reviewer": {
      "const": "Marcus"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "document_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "corpus_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
